# Default: normalise text files to LF
* text=auto eol=lf

# Text sources
*.md        text eol=lf
*.svg       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.sh        text eol=lf

# Binaries
*.png       binary
*.jpg       binary
*.jpeg      binary
*.pdf       binary
*.woff2     binary

# Evidence must keep its exact bytes.
# A single converted line ending changes the SHA-256 and breaks verification.
# Kept LAST on purpose: in .gitattributes, the last matching line wins.
*.har             -text
*.sha256          -text
*.ots             binary
*.age             binary
lab/fixtures/**   -text
